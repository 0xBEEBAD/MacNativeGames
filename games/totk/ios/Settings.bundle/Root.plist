<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>StringsTable</key>
	<string>Root</string>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>遊戲語言 · Game language</string>
			<key>FooterText</key>
			<string>重新啟動遊戲後生效 · takes effect after relaunching the game</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSRadioGroupSpecifier</string>
			<key>Key</key>
			<string>TOTK_LANG</string>
			<key>Title</key>
			<string>語言 · Language</string>
			<key>DefaultValue</key>
			<string></string>
			<key>Values</key>
			<array>
				<string></string>
				<string>zh-Hant</string>
				<string>zh-Hans</string>
				<string>en-US</string>
				<string>ja</string>
				<string>de</string>
				<string>es</string>
				<string>fr</string>
				<string>it</string>
				<string>nl</string>
				<string>ru</string>
				<string>ko</string>
			</array>
			<key>Titles</key>
			<array>
				<string>自動 · 跟隨系統語言 · Follow system language</string>
				<string>繁體中文</string>
				<string>简体中文</string>
				<string>English</string>
				<string>日本語</string>
				<string>Deutsch</string>
				<string>Español</string>
				<string>Français</string>
				<string>Italiano</string>
				<string>Nederlands</string>
				<string>Русский</string>
				<string>한국어</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>键盘 · Keyboard</string>
			<key>FooterText</key>
			<string>外接键盘会自动识别。插着键盘时触控按键会隐藏，打开第二项可保留触控。重新启动游戏后生效 · a hardware keyboard is detected automatically; while one is connected the touch controls hide, and the second switch below keeps them. Takes effect after relaunching</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Key</key>
			<string>TOTK_KEYBOARD</string>
			<key>Title</key>
			<string>使用外接键盘 · Use a hardware keyboard</string>
			<key>DefaultValue</key>
			<true/>
			<key>FooterText</key>
			<string>关闭后键盘按键不再操作游戏，触控与手柄不受影响 · off: the keyboard no longer drives the game; touch and controllers keep working</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Key</key>
			<string>TOTK_TOUCH_WITH_KEYBOARD</string>
			<key>Title</key>
			<string>插着键盘时保留触控 · Keep touch with a keyboard</string>
			<key>DefaultValue</key>
			<false/>
			<key>FooterText</key>
			<string>默认隐藏触控按键，避免误触；打开后两者可同时使用 · the touch controls hide by default to avoid stray taps; on: both work at once</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>除錯 · Debug</string>
			<key>FooterText</key>
			<string>開啟後把日誌寫進 App 的 Documents/log.txt（在 Mac 上讀取），會稍微影響效能；關閉時不記錄任何日誌。重新啟動遊戲後生效 · writes Documents/log.txt for reading on a Mac (slightly slower); off records nothing. Takes effect after relaunching the game</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Key</key>
			<string>TOTK_DEBUG_LOG</string>
			<key>Title</key>
			<string>記錄日誌 · Debug log</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
	</array>
</dict>
</plist>
